    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const raw = (\n  $json.text ??\n  $json.output ??\n  $json.response ??\n  $json.content ??\n  ''\n).toString().trim();\n\nlet parsed = null;\n\ntry {\n  parsed = JSON.parse(raw);\n} catch (e) {\n  const match = raw.match(/\\{[\\s\\S]*\\}/);\n  if (match) {\n    try {\n      parsed = JSON.parse(match[0]);\n    } catch (e2) {\n      parsed = null;\n    }\n  }\n}\n\nconst innovation = Number(parsed?.innovation ?? 0);\nconst feasibility = Number(parsed?.feasibility ?? 0);\n\nconst total_score = Number.isFinite(Number(parsed?.total_score))\n  ? Number(parsed.total_score)\n  : (innovation + feasibility);\n\nconst summary_score = String(parsed?.summary ?? '').slice(0, 200);\n\nlet level = '低';\nif (total_score >= 80) {\n  level = '高';\n} else if (total_score >= 50) {\n  level = '中';\n}\n\nreturn {\n  json: {\n    ...$json,\n    innovation,\n    feasibility,\n    total_score,\n    level,\n    score_summary: summary_score,\n    score_parse_ok: parsed !== null,\n    score_raw_llm_output: raw\n  }\n};"
      },
