      ],
      "id": "2002574a-80c7-4c72-b60d-da2760874601",
      "name": "评分及评语"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const title = ($json.title ?? $json.标题 ?? '').toString().trim();\nconst source = ($json[\"公众号名\"] ?? '').toString().trim();\nconst link = ($json.link ?? $json[\"原文链接\"] ?? $json.rss_url ?? '').toString().trim();\nconst time = ($json.pubDate ?? $json[\"时间\"] ?? '').toString().trim();\n\n// 当前标签（你 Text Classifier 输出的字段）\nconst category = ($json[\"领域分类\"] ?? '').toString().trim();\n\n// 文章级唯一ID（不含标签）\nconst article_id =\n  ($json.record_id ?? '').toString().trim() ||\n  link ||\n  `${source}__${title}__${time}`;\n\n// 文章+标签级唯一ID（用于后续 merge）\nconst merge_id = `${article_id}__${category}`;\n\nreturn {\n  json: {\n    ...$json,\n    article_id,   // 一篇文章唯一\n    merge_id      // 一篇文章 + 一个标签唯一\n  }\n};"
      },
