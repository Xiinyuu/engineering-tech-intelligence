        "jsCode": "function normalizeText(text = \"\") {\n  return text\n    .replace(/\\s+/g, \" \")\n    .replace(/[【】\\[\\]（）()]/g, \"\")\n    .replace(/转发|推荐|今日分享|精选/g, \"\")\n    .trim()\n    .toLowerCase();\n}\n\nconst account = $json[\"公众号名\"] || \"\";\nconst title = normalizeText($json[\"文章标题\"] || $json[\"标题\"] || \"\");\nconst link = ($json[\"原文链接\"] || $json[\"链接\"] || \"\").trim();\nconst content = normalizeText(($json[\"内容\"] || \"\").slice(0, 300));\n\nlet dedup_key = \"\";\nlet dedup_basis = \"\";\n\nif (link) {\n  dedup_key = link;\n  dedup_basis = \"链接\";\n} else if (title) {\n  dedup_key = title;\n  dedup_basis = \"标准化标题\";\n} else {\n  dedup_key = `${account}|${content}`;\n  dedup_basis = \"公众号名+内容前300字\";\n}\n\nreturn {\n  json: {\n    ...$json,\n    dedup_key,\n    dedup_basis\n  }\n};"
      },
